# Xingyu CMS — Backend (Flask)
FROM python:3.12-slim

WORKDIR /app

# Python dependencies (pure Python — no system compiler needed)
# 可用 --build-arg PIP_INDEX_URL=... 指定镜像源（默认官方源，行为不变）
ARG PIP_INDEX_URL=https://pypi.org/simple
COPY backend/requirements.txt .
RUN pip install --no-cache-dir --index-url "$PIP_INDEX_URL" -r requirements.txt

# Copy backend source
COPY backend/ .
ARG RELEASE_REVISION=development
RUN printf '%s\n' "$RELEASE_REVISION" > release_revision.txt

# Create uploads directory
RUN mkdir -p uploads

EXPOSE 5000

# Flask reads DEBUG from the selected application configuration; do not override it here.
CMD ["python", "-c", "from app import create_app; app = create_app(); app.run(host=app.config['APP_HOST'], port=app.config['APP_PORT'])"]
