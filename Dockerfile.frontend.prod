# Production frontend: build Vite assets once, then serve them with nginx.
FROM node:24-alpine AS build

WORKDIR /app

COPY frontendnew/package.json frontendnew/package-lock.json ./
# 可用 --build-arg NPM_REGISTRY=... 指定镜像源（默认官方源，行为不变）
ARG NPM_REGISTRY=https://registry.npmjs.org/
RUN npm ci --registry="$NPM_REGISTRY"

COPY frontendnew/ ./

# Empty keeps the browser on the same origin, where nginx proxies /api and /uploads.
ARG VITE_BACKEND_URL=""
ENV VITE_BACKEND_URL=${VITE_BACKEND_URL}
ARG VITE_PUBLIC_SITE_URL=""
ENV VITE_PUBLIC_SITE_URL=${VITE_PUBLIC_SITE_URL}
ARG RELEASE_REVISION=development
ENV RELEASE_REVISION=${RELEASE_REVISION}
RUN npm run build

FROM nginx:alpine

COPY deploy/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY deploy/nginx/frontend-proxy.inc /etc/nginx/frontend-proxy.inc
COPY --from=build /app/dist /opt/xingyu-dist
COPY --chmod=755 deploy/frontend/20-publish-bundle.sh /docker-entrypoint.d/20-publish-bundle.sh

EXPOSE 80
