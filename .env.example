# Copy this file to .env for local configuration. Never commit .env or real credentials.
# Replace every *_KEY placeholder before enabling the related external integration.

# Core backend runtime
# Generate distinct, high-entropy values before starting Compose. These blanks
# are deliberate: Compose refuses to start until both values are provided.
FLASK_ENV=development
SECRET_KEY=
JWT_SECRET_KEY=
DATABASE_URL=sqlite:////app/data/xingyu_cms.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
UPLOAD_FOLDER=/app/uploads
APP_DEBUG=false

# Docker Compose forwards every OSS, OCR, AI, and PUBLIC_BASE_URL value below
# into the backend container. Keep this file as a template; never commit .env.

# Frontend runtime. Compose resolves this inside the frontend container.
VITE_BACKEND_URL=http://backend:5000

# Object storage: disabled by default; leave provider/key/config placeholders non-secret.
OSS_ENABLED=false
OSS_PROVIDER=replace-with-provider-name
OSS_ACCESS_KEY_ID=replace-with-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-access-key-secret
OSS_BUCKET=replace-with-bucket-name
OSS_ENDPOINT=https://replace-with-object-storage-endpoint
OSS_PREFIX=uploads
OSS_PUBLIC_BASE_URL=https://replace-with-public-cdn-or-bucket-domain

# OCR: disabled by default.
OCR_ENABLED=false
OCR_PROVIDER=replace-with-provider-name
OCR_API_KEY=replace-with-ocr-api-key
OCR_ENDPOINT=https://replace-with-ocr-endpoint
OCR_MODEL=replace-with-vision-model-name

# Not required for certificate OCR: the backend reads managed local/OSS image
# bytes and sends a Data URL to the provider. Leave blank unless another
# application feature needs an externally visible base URL.
PUBLIC_BASE_URL=

# QQ 互联登录（可选）。在 QQ 互联创建网站应用后填写；
# 回调地址需与 QQ 互联后台完全一致，建议使用 PUBLIC_BASE_URL + /api/auth/qq/callback。
QQ_LOGIN_ENABLED=false
QQ_APP_ID=
QQ_APP_KEY=
QQ_REDIRECT_URI=

# AI: enables the project-management agent (chat, requirement parsing, weekly
# report analysis). Any OpenAI-chat-completions compatible provider works.
AI_ENABLED=false
AI_PROVIDER=replace-with-provider-name
AI_API_KEY=replace-with-ai-api-key
AI_BASE_URL=https://replace-with-ai-base-url
AI_MODEL=replace-with-model-name

# Agent reminder scanner: a lightweight background thread that turns due
# reminders and tasks expiring within 24h into in-app notifications.
REMINDER_SCAN_ENABLED=true
REMINDER_SCAN_INTERVAL=300

# Agent output limits: max tokens per chat reply and per requirement plan.
ASSISTANT_CHAT_MAX_TOKENS=2048
ASSISTANT_PARSE_MAX_TOKENS=4000
